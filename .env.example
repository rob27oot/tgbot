# توكن البوت من BotFather
BOT_TOKEN=

# رقم الماستر للتبرع
MASTER_PHONE=

# يوزر الدعم بدون @
SUPPORT_USERNAME=

# ايديات المشرفين، افصل بينها بفاصلة
ADMIN_IDS=

# قاعدة البيانات
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# اقصى حجم للفيديو بالميغابايت
MAX_FILE_SIZE_MB=50

# عدد التنزيلات المجانية باليوم
DAILY_FREE_DOWNLOADS=10